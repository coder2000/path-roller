{
  "schemaVersion": 1,
  "id": "pathroller",
  "version": "${version}",
  "name": "Path Roller",
  "description": "A roller that paves dirt paths as you walk, in any of eight directions and at a width you choose.",
  "authors": [
    "Dieter Lunn"
  ],
  "license": "MIT",
  "icon": "assets/pathroller/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ca.dieterlunn.pathroller.fabric.PathRollerFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "architectury": ">=${architectury_api_version}"
  }
}
